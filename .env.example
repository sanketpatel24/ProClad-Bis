# one8 back-in-stock — env vars (Vercel project settings)
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=production

# Bare host, e.g. 6qx7kf-as.myshopify.com (no https://)
SHOPIFY_STORE_DOMAIN=

# Admin API access token of a custom app with
# read_customers + write_customers + read_products scopes.
# Format: shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_ADMIN_TOKEN=

# Optional, comma-separated. Defaults to https://one8.com,https://www.one8.com
ALLOWED_ORIGINS=
